<mujoco model="simple_pan_tilt_laser_gimbal">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>

  <default>
    <joint damping="0.08" armature="0.002"/>
    <geom group="1" friction="0.8 0.1 0.1"
          solref="0.01 1"
          contype="0"
          conaffinity="0"/>
    <motor ctrllimited="false"/>
  </default>

  <worldbody>
    <light name="top_light" pos="0 -1 2" dir="0 0 -1"/>
    <geom name="ground" group="0" type="plane" pos="0 0 0"
          size="2 2 0.1" rgba="0.82 0.84 0.87 1"
          contype="0" conaffinity="0"/>

    <!-- Visible scan targets, in the environment ray-casting group. -->
    <geom name="scan_target_center" group="0" type="box" pos="1.5 0 0.25"
          size="0.08 0.25 0.25" rgba="0.8 0.3 0.2 1"/>
    <geom name="scan_target_left" group="0" type="box" pos="1.1 0.8 0.2"
          size="0.12 0.12 0.2" rgba="0.3 0.5 0.8 1"/>

    <!-- Fixed base: X forward, Y left, Z up. -->
    <body name="base" pos="0 0 0.015">
      <geom name="base_plate" type="box"
            pos="0 0 0" size="0.12 0.10 0.015"
            rgba="0.18 0.20 0.23 1"/>
      <geom name="yaw_pedestal" type="cylinder"
            pos="0 0 0.060" size="0.040 0.045"
            rgba="0.62 0.65 0.69 1"/>

      <!-- Fixed front sensor module; camera image right is -Y, up is +Z. -->
      <body name="front_sensors" pos="0.14 0 0.10">
        <geom name="camera_housing" type="box" size="0.025 0.035 0.025"
              rgba="0.12 0.14 0.17 1"/>
        <geom name="camera_lens" type="cylinder" pos="0.027 0 0"
              euler="0 1.57079632679 0" size="0.015 0.006" rgba="0.1 0.5 0.8 1"/>
        <camera name="fixed_camera" pos="0.035 0 0"
                xyaxes="0 -1 0 0 0 1" fovy="60"/>
        <geom name="lidar_housing" type="cylinder" pos="0 0 0.055"
              size="0.025 0.025" rgba="0.15 0.65 0.55 1"/>
        <site name="lidar_origin" pos="0.028 0 0.055"
              type="sphere" size="0.004" rgba="0 1 0.6 1"/>
      </body>

      <!-- Yaw stage rotates around world/local Z. -->
      <body name="yaw_stage" pos="0 0 0.105">
        <joint name="yaw_joint" type="hinge"
               axis="0 0 1"
               range="-3.14159265 3.14159265"
               limited="true"/>

        <geom name="yaw_platform" type="box"
              pos="0 0 0.0125"
              size="0.080 0.080 0.0125"
              rgba="0.12 0.32 0.72 1"/>

        <!-- Two simple pitch-axis support posts. -->
        <geom name="left_support" type="box"
              pos="0 0.070 0.080"
              size="0.0125 0.0125 0.080"
              rgba="0.62 0.65 0.69 1"/>
        <geom name="right_support" type="box"
              pos="0 -0.070 0.080"
              size="0.0125 0.0125 0.080"
              rgba="0.62 0.65 0.69 1"/>

        <!-- Pitch stage: positive pitch raises the +X laser ray. -->
        <body name="pitch_stage" pos="0 0 0.160">
          <joint name="pitch_joint" type="hinge"
                 axis="0 -1 0"
                 range="-0.785398 0.785398"
                 limited="true"/>

          <!-- Cross shaft along Y. -->
          <geom name="pitch_shaft" type="cylinder"
                pos="0 0 0"
                euler="1.57079632679 0 0"
                size="0.012 0.075"
                rgba="0.68 0.70 0.73 1"/>

          <!-- Laser housing; its long axis is local +X. -->
          <geom name="laser_housing" type="cylinder"
                pos="0.085 0 0"
                euler="0 1.57079632679 0"
                size="0.018 0.085"
                rgba="0.95 0.40 0.06 1"/>

          <geom name="laser_aperture" type="sphere"
                pos="0.172 0 0"
                size="0.010"
                rgba="0.95 0.05 0.04 1"/>

          <!-- Optical origin and direction: local +X. -->
          <site name="laser_origin"
                pos="0.172 0 0"
                type="sphere" size="0.004"
                rgba="1 0 0 1"/>
          <site name="laser_forward"
                pos="0.272 0 0"
                type="sphere" size="0.003"
                rgba="1 0 0 1"/>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position name="yaw_position"
              joint="yaw_joint"
              kp="35"
              ctrlrange="-3.14159265 3.14159265"/>
    <position name="pitch_position"
              joint="pitch_joint"
              kp="35"
              ctrlrange="-0.785398 0.785398"/>
  </actuator>

  <keyframe>
    <key name="home" qpos="0 0" ctrl="0 0"/>
  </keyframe>
</mujoco>
